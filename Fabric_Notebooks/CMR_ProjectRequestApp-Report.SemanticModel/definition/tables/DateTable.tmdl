	column 'Fiscal Quarter'
		lineageTag: a4a0500e-f862-4ef2-8ec4-160ccc8c37fa
		summarizeBy: none
		isNameInferred
		sourceColumn: [Fiscal Quarter]

		annotation SummarizationSetBy = Automatic

	partition DateTable = calculated
		mode: import
		source = ```
				
				    ADDCOLUMNS (
				        CALENDAR (DATE(2020, 1, 1), DATE(2040, 12, 31)),
				        "Year", YEAR([Date]),
				        "Month Number", MONTH([Date]),
				        "Month Name", FORMAT([Date], "MMMM"),
				        "Year-Month", FORMAT([Date], "YYYY-MM"),
				        "Fiscal Year", 
				            IF(MONTH([Date]) >= 4, 
				                YEAR([Date]) & "-" & RIGHT(YEAR([Date]) + 1, 2), 
				                YEAR([Date]) - 1 & "-" & RIGHT(YEAR([Date]), 2)),
				        "Fiscal Quarter", 
				            SWITCH(
				                TRUE(),
				                MONTH([Date]) >= 4 && MONTH([Date]) <= 6, "Q1",
				                MONTH([Date]) >= 7 && MONTH([Date]) <= 9, "Q2",
				                MONTH([Date]) >= 10 && MONTH([Date]) <= 12, "Q3",
				                MONTH([Date]) >= 1 && MONTH([Date]) <= 3, "Q4"
				            )
				    )
				
				
				```

	annotation PBI_Id = d7389483095f43fda58ee00ce50ee191

