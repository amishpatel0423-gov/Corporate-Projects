	column 'PD Initiation Status' = ```
			
			SWITCH(
			    TRUE(),
			    NOT(ISBLANK(pmbcp_cmrprojreqmain[Sent to Project Delivery])) && NOT(ISBLANK(pmbcp_cmrprojreqmain[PD PAR Received Date])),"PAR Received",
			    NOT(ISBLANK(pmbcp_cmrprojreqmain[Sent to Project Delivery])) && ISBLANK(pmbcp_cmrprojreqmain[PD PAR Received Date]),"PD Initiation In Progress",
			    ISBLANK(pmbcp_cmrprojreqmain[Sent to Project Delivery]) && ISBLANK(pmbcp_cmrprojreqmain[PD PAR Received Date]),"Pending Send to PD",
			    ISBLANK(pmbcp_cmrprojreqmain[Sent to Project Delivery]) && NOT(ISBLANK(pmbcp_cmrprojreqmain[PD PAR Received Date])),"Error"
			)
			
			```
		lineageTag: 8def2976-2f81-4719-8ac8-2dc96354295b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Migrated Request' = If(pmbcp_cmrprojreqmain[Created By]="INF-CP-PP S","Yes","No")
		lineageTag: 8b67e6c3-a67b-48fb-9e23-fd8faa9e74ff
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'PD Cost Difference' =
			
			VAR PARrequested = pmbcp_cmrprojreqmain[PAR Requested TPC]
			VAR EstTPC = RELATED(pmbcp_projectsummarydata[Cost Factored TPC])
			RETURN IF(
			    NOT(ISBLANK(pmbcp_cmrprojreqmain[PAR Requested TPC]) || ISBLANK(RELATED(pmbcp_projectsummarydata[Cost Factored TPC]))),
			    ABS(PARrequested - EstTPC),
			    BLANK()
			)
		lineageTag: 78b4bd76-f949-4dd4-85ba-d2a80873bcf6
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Meet CutOff Score' =
			
			VAR Score = RELATED(pmbcp_projectsummarydata[Priority Score (number)])
			RETURN
			IF(
			    NOT ISBLANK(Score),
			    IF(Score < [CutOff Score], "No", "Yes"),
			    "No Data"
			)
		lineageTag: b39afffc-987b-47ce-90a5-9517f4ff5a7f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'PD Cost Difference Percent' =
			
			VAR PARrequested = pmbcp_cmrprojreqmain[PAR Requested TPC]
			VAR EstTPC = RELATED(pmbcp_projectsummarydata[Cost Factored TPC])
			RETURN IF(
			    NOT(ISBLANK(pmbcp_cmrprojreqmain[PAR Requested TPC]) || ISBLANK(RELATED(pmbcp_projectsummarydata[Cost Factored TPC]))),
			    (PARrequested - EstTPC)/EstTPC,
			    BLANK()
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: f46566ef-7bfc-4c90-91b3-0a4aaa6d5ae9
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

