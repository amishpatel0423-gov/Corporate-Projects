			    DATEDIFF(pmbcp_cmrprojreqmain[Tech Review PMPI Director Complete Date],TODAY(),DAY),
			    DATEDIFF(pmbcp_cmrprojreqmain[Tech Review PMPI Director Complete Date],pmbcp_cmrprojreqmain[Facilities Finalization Date],DAY)
			))
		formatString: 0
		lineageTag: 35715440-a2d0-4a00-8e9f-fdceb0bacae1
