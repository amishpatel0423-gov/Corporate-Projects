	column DaysforTechRevBDSMgr = ```
			
			VAR BDSManagerStartDate = 
			If(pmbcp_cmrprojreqmain[Work Status] = "Waiting for Approval" && pmbcp_cmrprojreqmain[Technical Review Status] = "Waived",
			    pmbcp_cmrprojreqmain[Tech Review Waived Date],
			    pmbcp_cmrprojreqmain[Tech Review Draft Complete])
			RETURN
			    If(ISBLANK(pmbcp_cmrprojreqmain[Tech Review BDS Manager Complete Date]),
			    DATEDIFF(BDSManagerStartDate,TODAY(),DAY),
			    DATEDIFF(BDSManagerStartDate,pmbcp_cmrprojreqmain[Tech Review BDS Manager Complete Date],DAY))
