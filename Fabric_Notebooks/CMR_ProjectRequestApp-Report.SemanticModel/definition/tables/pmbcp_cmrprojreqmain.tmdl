	column 'Request Status (groups)' =
			SWITCH(
				TRUE,
				ISBLANK('pmbcp_cmrprojreqmain'[Request Status]),
				"(Blank)",
				'pmbcp_cmrprojreqmain'[Request Status] IN {"Pending FM Decision"},
				"1 - Pending FM Decision",
				'pmbcp_cmrprojreqmain'[Request Status] IN {"Technical Review"},
				"2 - Technical Review",
				'pmbcp_cmrprojreqmain'[Request Status] IN {"Finalize Request"},
				"3 - Finalize Request",
				'pmbcp_cmrprojreqmain'[Request Status] IN {"Pending Director Decision"},
				"4 - Pending Director Decision",
				'pmbcp_cmrprojreqmain'[Request Status] IN {"Pending Funding Classification"},
				"5 - Pending Funding Classification",
				'pmbcp_cmrprojreqmain'[Request Status] IN {"Project Delivery Initiation"},
				"6 - Project Delivery Initiation",
				'pmbcp_cmrprojreqmain'[Request Status] IN {"Prepare for Approval"},
				"7 - Prepare for Approval",
				'pmbcp_cmrprojreqmain'[Request Status] IN {"Executive Review"},
				"8 - Executive Review",
				'pmbcp_cmrprojreqmain'[Request Status] IN {"Project Setup"},
				"9 - Project Setup",
				'pmbcp_cmrprojreqmain'[Request Status] IN {"Approved"},
				"Approved",
				'pmbcp_cmrprojreqmain'[Request Status]
			)
		lineageTag: f6454915-2982-4901-99ba-80811f068706
		summarizeBy: none

