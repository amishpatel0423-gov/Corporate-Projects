	column DaysforPD =
			
			VAR BaseDuration =
			    IF(
			        pmbcp_cmrprojreqmain[Project Lead] = "Project Delivery Team",
			        DATEDIFF(
			            pmbcp_cmrprojreqmain[Sent to Project Delivery],
			            IF(
			                ISBLANK(pmbcp_cmrprojreqmain[PD PAR Received Date]),
			                TODAY(),
			                pmbcp_cmrprojreqmain[PD PAR Received Date]
			            ),
			            DAY
			        )
			    )
			
			VAR HoldDuration =
			    SUMX(
			        FILTER(
			            pmbcp_cmrholdaction,
			            pmbcp_cmrholdaction[CMR Project Request] = pmbcp_cmrprojreqmain[Request ID]
			            && pmbcp_cmrholdaction[Previous Request Status] = 211700005
			        ),
			        DATEDIFF(
			            pmbcp_cmrholdaction[Hold Start Date],
			            IF(
			                ISBLANK(pmbcp_cmrholdaction[Hold End Date]),
			                TODAY(),
			                pmbcp_cmrholdaction[Hold End Date]
			            ),
			            DAY
			        )
			    )
			
			RETURN
			    BaseDuration - HoldDuration
		formatString: 0
		lineageTag: 86694e69-91b4-4b26-a841-e7d46f69872b
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

