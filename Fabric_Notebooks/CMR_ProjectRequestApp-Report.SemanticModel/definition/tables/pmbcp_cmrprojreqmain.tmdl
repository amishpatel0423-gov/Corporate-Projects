	column 'Technical Review Status (groups)' =
			SWITCH(
				TRUE,
				ISBLANK('pmbcp_cmrprojreqmain'[Technical Review Status]),
				"(Blank)",
				'pmbcp_cmrprojreqmain'[Technical Review Status] IN {"Pending"},
				"0-Pending",
				'pmbcp_cmrprojreqmain'[Technical Review Status] IN {"Draft In Progress"},
				"1-Draft In Progress",
				'pmbcp_cmrprojreqmain'[Technical Review Status] IN {"Draft Complete"},
				"2-Draft Complete",
				'pmbcp_cmrprojreqmain'[Technical Review Status] IN {"Action for BDS"},
				"2.1-Action for BDS",
				'pmbcp_cmrprojreqmain'[Technical Review Status] IN {"Complete"},
				"3-Complete",
				'pmbcp_cmrprojreqmain'[Technical Review Status] IN {"Waived"},
				"4-Waived",
				'pmbcp_cmrprojreqmain'[Technical Review Status] IN {"Not Applicable"},
				"5-Not Applicable",
				"Other"
			)
		lineageTag: 47d370f5-bcab-4714-ac37-0aa537003fd7
		summarizeBy: none

