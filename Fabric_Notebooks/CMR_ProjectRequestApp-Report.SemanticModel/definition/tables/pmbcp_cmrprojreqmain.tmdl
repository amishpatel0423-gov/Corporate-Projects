	column 'Tech Review Waived' = If(pmbcp_cmrprojreqmain[Technical Review Status] = "Waived", "Yes","No")
		lineageTag: 274aa5c6-b099-4b67-8db9-51955988d334
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column DaysforWaived =
			If(
			    pmbcp_cmrprojreqmain[Work Status] = "Waiting for Approval" && pmbcp_cmrprojreqmain[Technical Review Status] = "Waived",
			    DATEDIFF(pmbcp_cmrprojreqmain[FM Initial Decision Date],pmbcp_cmrprojreqmain[Tech Review Waived Date],DAY)
			    )
		formatString: 0
		lineageTag: fc96500f-4139-4d13-a5e5-f1fa2374514b
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Tech Review In Progress' = If(ISBLANK(pmbcp_cmrprojreqmain[Tech Review PMPI Director Complete Date]) && pmbcp_cmrprojreqmain[Technical Review Status] <> "Not Applicable" && pmbcp_cmrprojreqmain[Technical Review Status] <> "Pending", "Yes", "No")
		lineageTag: 397f1f17-004d-4e36-9953-41d1f597ad8a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Requested Fiscal Year' = ```
			
			LOOKUPVALUE(
			    DateTable[Fiscal Year],
			    DateTable[Date],
			    DATE(
			        YEAR(pmbcp_cmrprojreqmain[Created On]),
			        MONTH(pmbcp_cmrprojreqmain[Created On]),
			        DAY(pmbcp_cmrprojreqmain[Created On])
			    )
			)
			
			
			
			```
