			)
		lineageTag: 0f4691a2-9bc4-444e-9219-6efbe42ed575

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg for Project Setup' =
			
			CALCULATE(
			    AVERAGE(pmbcp_cmrprojreqmain[DaysforProjSetup])
			)
		lineageTag: 9bca6697-c6dc-47cb-b0d7-4d1b87be47fb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg to Approve' =
			CALCULATE(
			    AVERAGE(pmbcp_cmrprojreqmain[DaystoApprove]))
		lineageTag: d4dd0e67-af26-4636-824a-8de83f152242

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure AvgStageDuration = ```
			
			SWITCH(
			    SELECTEDVALUE(BPFStageAxis[Stage]),
			    "Initial FM Decision", [Avg for Initiate],
			    "Technical Review", [Avg for Technical Review],
			    "Finalize", [Avg for Finalize],
			    "Director Decision", [Avg for Director Decision],
			    "Funding Classification", [Avg for Funding Classification],
			    "Project Delivery Initiation", [Avg for PD Initiation],
			    "Prepare for Approval", [Avg for Prep for Approval],
			    "Executive Review", [Avg for Exec Review],
			    "Project Setup", [Avg for Project Setup]
			)
			
			```
		lineageTag: a241ab9b-400a-4d8a-9e8b-a096f7c25b16

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg for Tech Review Draft' =
			CALCULATE(
			    AVERAGE(pmbcp_cmrprojreqmain[DaysforTechRevDraftComp]))
		lineageTag: d1fa9c01-fea1-458a-bb0f-424f78506200

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg for Tech Review BDS Manager' =
			CALCULATE(
			    AVERAGE(pmbcp_cmrprojreqmain[DaysforTechRevBDSMgr])
			)
		lineageTag: 17a7bab6-923a-409b-861c-d9aac20b1bea

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg for Tech Review Draft PMPI Director' =
			CALCULATE(
			    AVERAGE(pmbcp_cmrprojreqmain[DaysforTechRevPMPIDir]))
		lineageTag: 6d6bc27a-6a4a-41b6-a284-4df60b217e58

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Requests Above Tech Review Average' = ```
			
			VAR AvgTechRev = [Avg for Technical Review]
			RETURN
			CALCULATE(
			    COUNTROWS(pmbcp_cmrprojreqmain),
			    FILTER(
			        pmbcp_cmrprojreqmain,
			        pmbcp_cmrprojreqmain[DaysforTechRev] > AvgTechRev
			    )
			)
			
			```
		formatString: 0
		lineageTag: 2b6befe6-8863-4936-b78b-051c7ed42b60

	measure 'CutOff Score' = 85
		formatString: 0
		lineageTag: 181c3ee3-a93f-441a-a2a4-0cca4f002837

	measure 'Requests Above PD Average' =
			
			VAR AvgPD = [Avg for PD Initiation]
			RETURN
			CALCULATE(
			    COUNTROWS(pmbcp_cmrprojreqmain),
			    FILTER(
			        pmbcp_cmrprojreqmain,
			        pmbcp_cmrprojreqmain[DaysforPD] > AvgPD
			    )
			)
		formatString: 0
		lineageTag: f4d113e9-d334-43bb-8da9-1becbc12435f

	measure 'Total Project Value' = ```
			
			VAR RequestedTPC = SELECTEDVALUE(pmbcp_cmrprojreqmain[par requested tpc])
			VAR SummaryTPC = 
			    CALCULATE(
			        SUM(pmbcp_projectsummarydata[Cost Factored TPC]),
			        TREATAS(VALUES(pmbcp_cmrprojreqmain[RAP ID]), pmbcp_projectsummarydata[RAP ID])
			    )
			
			VAR FinalValue = 
			    IF(NOT(ISBLANK(RequestedTPC)) && RequestedTPC <> 0, RequestedTPC,
			        SummaryTPC
			        )
			
			
			RETURN FinalValue
			```
		formatString: \$#,0.###############;-\$#,0.###############;\$#,0.###############
		lineageTag: d42ac064-4dda-42bf-8808-4e048130dcf0

		annotation PBI_FormatHint = {"currencyCulture":"en-CA"}

	measure 'Total Project Value (Filtered)' =
			
			CALCULATE (
			    SUMX (
			        pmbcp_cmrprojreqmain,
			        IF (
			            ISBLANK ( pmbcp_cmrprojreqmain[par requested tpc] ) || pmbcp_cmrprojreqmain[par requested tpc] = 0,
			            pmbcp_cmrprojreqmain[Estimated TPC (Cost Factored)],
			            pmbcp_cmrprojreqmain[par requested tpc]
			        )
			    ),
			    pmbcp_cmrprojreqmain[Request Status] <> "Cancelled"
			)
		formatString: \$#,0.###############;-\$#,0.###############;\$#,0.###############
		lineageTag: 3dd0a20b-e156-4aaf-b441-5e4186e6bb48

		annotation PBI_FormatHint = {"currencyCulture":"en-CA"}

	measure LinkText = "View Record"
		lineageTag: 7453c236-9eff-4629-8857-3f8573767748

