	column DaysforTechRevDraftComp =
			If(
			    pmbcp_cmrprojreqmain[Work Status] = "Waiting for Approval" && pmbcp_cmrprojreqmain[Technical Review Status] <> "Waived",
			    If(ISBLANK(pmbcp_cmrprojreqmain[Tech Review Draft Complete]),
			        DATEDIFF(pmbcp_cmrprojreqmain[FM Initial Decision Date],TODAY(),DAY),
			        DATEDIFF(pmbcp_cmrprojreqmain[FM Initial Decision Date],pmbcp_cmrprojreqmain[Tech Review Draft Complete],DAY)
