	column 'Tech Review Component Count' = If(pmbcp_cmrprojreqmain[O&M Assessment]="Yes",1,0)+IF(pmbcp_cmrprojreqmain[OHS Assessment]="Yes",1,0)+If(pmbcp_cmrprojreqmain[Security Assessment]="Yes",1,0)+If(pmbcp_cmrprojreqmain[Energy Assessment]="Yes",1,0)
