	column DaystoApprove = ```
			
			VAR SentToPDDate = pmbcp_cmrprojreqmain[Sent to Project Delivery]
			VAR CreatedOnDate = pmbcp_cmrprojreqmain[Created On]
			VAR CompleteDate = pmbcp_cmrprojreqmain[Complete Date]
			
			VAR StartDate = 
			    IF(
			        NOT ISBLANK(SentToPDDate),
			        MIN(CreatedOnDate, SentToPDDate),
			        CreatedOnDate
			    )
			
			VAR EndDate = 
			    IF(
			        ISBLANK(CompleteDate),
			        TODAY(),
			        CompleteDate
			    )
			
			VAR BaseDuration = DATEDIFF(StartDate, EndDate, DAY)
			
			VAR TotalHoldDuration =
			    SUMX(
			        FILTER(
			            pmbcp_cmrholdaction,
			            pmbcp_cmrholdaction[CMR Project Request] = pmbcp_cmrprojreqmain[Request ID]
			        ),
			        DATEDIFF(
			            pmbcp_cmrholdaction[Hold Start Date],
			            IF(
			                ISBLANK(pmbcp_cmrholdaction[Hold End Date]),
			                TODAY(),
			                pmbcp_cmrholdaction[Hold End Date]
			            ),
			            DAY
			        )
			    )
			
			RETURN
			    BaseDuration - TotalHoldDuration
			```
		formatString: 0
		lineageTag: cc5356ee-4497-46eb-9f10-80842c87bae7
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column DaystoInitialDecision =
			IF(ISBLANK(pmbcp_cmrprojreqmain[FM Initial Decision Date]),
			    DATEDIFF(pmbcp_cmrprojreqmain[Created On],TODAY(),DAY),
			    DATEDIFF(pmbcp_cmrprojreqmain[Created On],pmbcp_cmrprojreqmain[FM Initial Decision Date],DAY)
			)
		formatString: 0
		lineageTag: 74d08cae-6163-4568-95d4-108552a7fff5
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column DaysforTechRev =
			If(
			    pmbcp_cmrprojreqmain[Work Status] = "Waiting for Approval",
			    If(ISBLANK(pmbcp_cmrprojreqmain[Tech Review PMPI Director Complete Date]),
			    DATEDIFF(pmbcp_cmrprojreqmain[FM Initial Decision Date],TODAY(),DAY),
			    DATEDIFF(pmbcp_cmrprojreqmain[FM Initial Decision Date],pmbcp_cmrprojreqmain[Tech Review PMPI Director Complete Date],DAY)
			    ))
		formatString: 0
		lineageTag: 8d409a04-f4eb-49bd-a50e-ae32b5dac0d3
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column DaysforFinalize =
