table LastRefresh
	lineageTag: 166d889a-66a6-487b-aa5e-2b9c8b1cf765

	measure RefreshCard = "Refreshed: " & FORMAT(VALUES('LastRefresh'[Date Last Refreshed])-TIME(7,0,0),"mmm dd/yy h:mm AM/PM")
