/// Source VFA_EMPMI_Staging for requirement scoring. Data validation happens in the VFADataValidation Query
expression CommonScoringModel = ```
		/*
		Query Name: ProjectRequestScoring
		Source: VFA_EMPMI_Staging
		Dependencies: 
		About: a version of the common scoring model adapted for the CMR Project Request Power App
		
		Version: 2.2
		Last Update Date(mmddyyyy): 03-17-2025
		Last Updated By: CM
		Release Date: 
		
		Version History: 
		- added the isrenewal lifecycle category error
		- fixed a bug with the missing uniformat error
		- modified the code to use the full requirement uniformat for the join instead of the uniformat code split
		- other changes to update this one-off model
		- removes the switch of data source
		
		TODO: 
		- 
		
		*/
		//******************start of query*****************************//
		let
		    Source = VFA_EMPMI_Staging,
		    //#"Changed Type" = Table.TransformColumnTypes(Switch, {{"Estimated Cost", Int64.Type}}),
		    //#"Filtered Rows" = Table.SelectRows(#"Changed Type", each ([RAP ID] = fnGetParameters("RAP ID"))),
		    #"Join to IoSF" = Table.NestedJoin(
		        Source, {"Uniformat"}, #"IoSF", {"System - Uniformat"}, "IoSF", JoinKind.LeftOuter
		    ),
		    #"Get IoSF Data" = Table.ExpandTableColumn(#"Join to IoSF", "IoSF", {"Importance of System Functionality", "Score with Weight", "System - Uniformat", "System Group"}, {"IoSF.ImportanceofSystemFunctionality", "IoSF.ScorewithWeight", "IoSF.System - Uniformat", "IoSF.System Group"}),
		
		    #"Renamed System Columns" = Table.RenameColumns(
		        #"Get IoSF Data",
		        {{"IoSF.System - Uniformat", "MasterSystemUniformat"}, {"IoSF.System Group", "MasterSystemGroup"}}
		    ),
		    #"Join to PlanForAsset" = Table.NestedJoin(
		        #"Renamed System Columns",
		        {"BuildingPriorityDetail"},
		        #"PlanForAsset",
		        {"Building Priority Detail"},
		        "PlanForAsset",
		        JoinKind.LeftOuter
		    ),
		    #"Expanded PlanForAsset" = Table.ExpandTableColumn(#"Join to PlanForAsset", "PlanForAsset", {"Plan for Asset", "Score with Weight"}, {"PFA.PlanForAsset", "PFA.ScorewithWeight"}),
		    #"Join to IoAF" = Table.NestedJoin(
		        #"Expanded PlanForAsset", {"AssetUse"}, #"IoAF", {"Asset Use"}, "IoAF", JoinKind.LeftOuter
		    ),
		    #"Expanded IoAF" = Table.ExpandTableColumn(#"Join to IoAF", "IoAF", {"Importance of Asset Functionality", "Score with Weight"}, {"IoAF.ImportanceofAssetFunctionality", "IoAF.ScorewithWeight"}),
		
		    #"Join Priority to ConditionOfSystem" = Table.NestedJoin(
		        #"Expanded IoAF",
		        {"Priority"},
		        #"ConditionOfSystem",
		        {"Requirement Priority"},
		        "ConditionOfSystem",
		        JoinKind.LeftOuter
		    ),
		    #"Expanded ConditionOfSystem" = Table.ExpandTableColumn(#"Join Priority to ConditionOfSystem", "ConditionOfSystem", {"Condition of System", "Score with Weight"}, {"Condition.ConditionofSystem", "Condition.ScorewithWeight"}),
		    #"Join Category to Reason for Work" = Table.NestedJoin(
		        #"Expanded ConditionOfSystem",
		        {"Category"},
		        #"ReasonForWork",
		        {"Requirement Category"},
		        "ReasonForWork",
		        JoinKind.LeftOuter
		    ),
		    #"Expanded ReasonForWork" = Table.ExpandTableColumn(#"Join Category to Reason for Work", "ReasonForWork", {"Reason for Work", "Score with Weight"}, {"Reason.ReasonforWork", "Reason.ScorewithWeight"}),
		    #"Join to ImpactOfFailure" = Table.NestedJoin(
		        #"Expanded ReasonForWork",
		        {"Impact"},
		        #"ImpactOfFailure",
		        {"Requirement Impact"},
		        "ImpactOfFailure",
		        JoinKind.LeftOuter
		    ),
		    #"Expanded ImpactOfFailure" = Table.ExpandTableColumn(#"Join to ImpactOfFailure", "ImpactOfFailure", {"Impact of Failure", "Score with Weight"}, {"Impact.ImpactofFailure", "Impact.ScorewithWeight"}),
		    #"Renamed CMR Scoring Columns" = Table.RenameColumns(
		        #"Expanded ImpactOfFailure",
		        {
		            {"PFA.PlanForAsset", "PlanForAsset"},
		            {"PFA.ScorewithWeight", "PFA.Score"},
		            {"IoAF.ImportanceofAssetFunctionality", "IoAF"},
		            {"IoAF.ScorewithWeight", "IoAF.Score"},
		            {"IoSF.ImportanceofSystemFunctionality", "IoSF"},
		            {"IoSF.ScorewithWeight", "IoSF.Score"},
		            {"Condition.ConditionofSystem", "ConditionofSystem"},
		            {"Condition.ScorewithWeight", "Condition.Score"},
		            {"Reason.ReasonforWork", "ReasonforWork"},
		            {"Reason.ScorewithWeight", "Reason.Score"},
		            {"Impact.ImpactofFailure", "ImpactofFailure"},
		            {"Impact.ScorewithWeight", "Impact.Score"}
		        }
		    ),
		    #"Inserted Sum of Ratings" = Table.AddColumn(
		        #"Renamed CMR Scoring Columns",
		        "Addition",
		        each
		            List.Sum(
		                {[PFA.Score], [IoAF.Score], [IoSF.Score], [Condition.Score], [Reason.Score], [Impact.Score]}
		            ),
		        Int64.Type
		    ),
		    #"Change Score to Text" = Table.TransformColumnTypes(#"Inserted Sum of Ratings",{{"Addition", type text}}),
		    #"End" = Table.RenameColumns(#"Change Score to Text", {{"Addition", "PriorityScore"}})
		in
		    End
		```
	lineageTag: 3df00615-4e84-4327-b744-700225172be3
	queryGroup: CommonModels

