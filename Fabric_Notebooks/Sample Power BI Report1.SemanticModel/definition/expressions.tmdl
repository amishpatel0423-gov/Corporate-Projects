expression MasterScoringConnection = ```
		/*
		Query Name: MasterScoringTablesConnection
		Source: SharePoint Excel File
		Dependencies: Scoring Criteria Queries, CommonScoringModel
		About: Provides the connection to the dependant scoring queries. Contains the five scoring tables used to calculate proiority scores for the CMR business process and methodology. The single source for all dependent modules and queries so if the location of the excel file moves,the link only has to be updated in one place.
		
		https://abgov.sharepoint.com/sites/S300D13-PMB-CORP-PROJ13424/InfrasCMR/CMR%20Template%20Source%20&%20Documentation/CMR%20Source%20Code%20Repo/CommonModules/CommonMasterScoring/Master_CMR_ScoringTables.xlsx
		
		Version: 1.0
		Last Update Date (mmddyyyy): 03-17-2025 
		Last Updated By: CM
		Release Date: 
		
		Version History: 
		- Initial Version
		
		TODO: 
		
		*/
		//******************start of query*****************************//
		
		let
		    // Connect to the SharePoint site
		    SharePointSite = "https://abgov.sharepoint.com/sites/S300D13-PMB-CORP-PROJ13424",
		    Source = SharePoint.Files(SharePointSite, [ApiVersion = 15]),
		
		    // Filter to the specific file
		    FilteredFile = Table.SelectRows(Source, each Text.Contains([Folder Path], "CMR Source Code Repo/CommonModules/CommonMasterScoring") 
		        and [Name] = "Master_CMR_ScoringTables.xlsx"),
		
		    // Get the binary content of the file
		    FileBinary = FilteredFile{0}[Content],
		
		    // Load the Excel workbook
		    ExcelData = Excel.Workbook(FileBinary, null, true)
		in
		    ExcelData
		```
	lineageTag: 42714edb-8ee1-4ab8-a7eb-33026a714660
	queryGroup: CommonModels\MasterScoring

	annotation PBI_ResultType = Table

expression RAP_Projects_SSRS =
		let
		    Source = Csv.Document(
		        Web.Contents("https://rpt.infrastructure.alberta.ca/ReportServer?/RAP-PM/RAP-Project%20Information%20Report&rs:Format=CSV"),
		        [Delimiter = ","]
		    ),
		    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
		    #"Make Record_Create DateTime" = Table.TransformColumnTypes(#"Promoted Headers",{{"Record_Created", type datetime}}),
		
		    BringRAPForwardToUpdate = {
		        {"S0395", "006"},
		        {"S0001", "253"},
		        {"B0731A", "045"},
		        {"B0531A", "034"}
		    },
		
		    UpdatedTable = Table.FromRecords(
		        List.Transform(
		            Table.ToRecords(#"Make Record_Create DateTime"),
		            each if List.Contains(BringRAPForwardToUpdate, {_[Property], _[Number]}) then
		                Record.TransformFields(_, {{"Record_Created", each #date(2021, 1, 1)}})
		            else _
		        )
		    ),
		    #"Changed Type1" = Table.TransformColumnTypes(UpdatedTable,{{"Record_Created", type datetime}}),
		    #"Filtered Rows" = Table.SelectRows(#"Changed Type1", each ([Property] = "B0663B") and ([Deleted] = "No"))
		in
		    #"Filtered Rows"
	lineageTag: ed678d67-0f7c-447d-8c26-d80cf189678d
	queryGroup: DataSources

	annotation PBI_ResultType = Table

expression VFA_EMPMI =
		let
		    // Direct static URL to the SSRS report in CSV format
		    Source = Csv.Document(
		        Web.Contents("https://rpt.infrastructure.alberta.ca/ReportServer?/RAP-PM/VFA-LinkedRequirments&rs:Format=CSV"),
		        [Delimiter = ","]
		    ),
		    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
		    #"Changed Type Source" = Table.TransformColumnTypes(
		        #"Promoted Headers",
		        {
		            {"Portfolio_Name", type text},
		            {"Property_Name", type text},
		            {"Asset_EID", type text},
		            {"Asset_Name", type text},
		            {"Building_ID", type text},
		            {"Use_Type", type text},
		            {"Building_Priority_Detail", type text},
		            {"Requirement_EID", type text},
		            {"Requirement_Name", type text},
		            {"Requirement_Description", type text},
		            {"Linked_System", type any},
		            {"Category", type text},
		            {"Priority", type text},
		            {"Impact", type text},
		            {"EstimatedCost", Int64.Type},
		            {"RAPProjectID", type text},
		            {"RAPProjectStatus", type text},
		            {"System_EID", type text},
		            {"System_Name", type text},
		            {"Uniformat", type text},
		            {"System_Group", type text},
		            {"IsRenewal", type logical},
		            {"OutForAudit", type logical}
		        }
		    ),
		
		    #"Filter Out NON-PR Portfolios" = Table.SelectRows(#"Changed Type Source", each ([Portfolio_Name] <> "" and [Portfolio_Name] <> "ABHS-Calgary" and [Portfolio_Name] <> "ABHS-Central" and [Portfolio_Name] <> "ABHS-Edmonton" and [Portfolio_Name] <> "ABHS-North" and [Portfolio_Name] <> "PR-PMDC-Plan 020482 L-TUC_EDON" and [Portfolio_Name] <> "PSI-Northern Lakes College" and [Portfolio_Name] <> "SEN-Owned/Operated by Mgmt Body")),
		    LastRefreshDate = Table.AddColumn(#"Filter Out NON-PR Portfolios", "LastRefreshDate", each DateTime.LocalNow()),
		    #"Filtered Rows" = Table.SelectRows(LastRefreshDate, each ([Building_ID] = "B0663B") and ([RAPProjectID] = "B0663B-070"))
		in
		    #"Filtered Rows"
	lineageTag: 1fa73823-b7b7-41b0-9c55-0b1315c56a5c
	queryGroup: DataSources

