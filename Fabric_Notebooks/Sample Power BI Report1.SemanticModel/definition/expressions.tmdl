expression Building_List = ```
		/*
		Query Name: Building_List
		Source: sharepoint building list
		Dependencies: working (query)
		About: A straight pull in from the sharepoint building list excel file. This is a resource for PMB buildings information, contacts, portfolios, address, financial codes etc. 
		
		https://abgov.sharepoint.com/sites/S300D13-PMBL/Shared%20Documents/PMB%20Building-Contact%20List.xlsx
		
		Version: 1.2
		Last Update Date (mmddyyyy): 11-26-2025
		Last Updated By: CM
		Release Date (mmddyyyy): 11-26-2024
		
		Version History: 
		- updated link to new SharePoint library
		
		TODO: 
		- parameterize the location of the file. Note, this file may be replaced with a dataverse table in the future.
		
		*/
		//******************start of query*****************************//
		
		let
		    // Connect to the SharePoint site
		    SharePointSite = "https://abgov.sharepoint.com/sites/S300D13-PMBL",
		    Source = SharePoint.Files(SharePointSite, [ApiVersion = 15]),
		
		    // Filter to the specific file
		    FilteredFile = Table.SelectRows(Source, each 
		        [Name] = "PMB Building-Contact List.xlsx" and 
		        Text.Contains([Folder Path], "Shared Documents")
		    ),
		
		    // Get the file content
		    FileBinary = FilteredFile{0}[Content],
		
		    // Load the Excel workbook
		    ExcelData = Excel.Workbook(FileBinary, null, true),
		
		    // Extract the desired table
		    BuildingListTable = ExcelData{[Item="Building_List", Kind="Table"]}[Data],
		
		    // Promote headers and set data types
		    ChangedTypes = Table.TransformColumnTypes(BuildingListTable, {
		        {"LOCATION", type text},
		        {"BLDGID", type text},
		        {"BLDGNAME", type text},
		        {"ADDRESS", type text},
		        {"OWNER", type text},
		        {"Director Level", type text},
		        {"Director Level Contact Name", type text},
		        {"Internal Order", type text},
		        {"Cost Center", Int64.Type},
		        {"Org", Int64.Type},
		        {"Facility Manager", type text},
		        {"Facility Manager Contact Name", type text},
		        {"Facility Manager Phone #", type text},
		        {"Facility Coordinator Contact Name", type text},
		        {"Facility Coordinator Phone #", type text},
		        {"TPM", type text},
		        {"TPM Contact Name", type text},
		        {"INSPECT_TYPID", type text},
		        {"INSPECT_TYPNAM", type text},
		        {"Director Email", type text},
		        {"FM Email", type text},
		        {"__PowerAppsId__", type text}
		    })
		in
		 ChangedTypes
		```
	lineageTag: 2b4832e6-66fd-4584-bad1-a3a0db3ef7da
	queryGroup: DataSources

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression ImpactOfFailure = ```
		/*
		Query Name: ImpactOfFailure
		Source: MasterScoringConnection
		Dependencies: CommonScoringModel
		About: Provides connection to the master scoring table impact as impact of failure
		
		https://abgov.sharepoint.com/sites/S300D13-PMB-CORP-PROJ13424/InfrasCMR/CMR%20Template%20Source%20&%20Documentation/CMR%20Source%20Code%20Repo/CommonModules/CommonMasterScoring/Master_CMR_ScoringTables.xlsx
		
