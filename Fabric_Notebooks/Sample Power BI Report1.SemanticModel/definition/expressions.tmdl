expression ProjectRequestSummary = ```
		/*
		Query Name:ProjectRequestSummary
		Source: RAP_Projects_Staging
		Dependencies: 
		About: Provides the dataflow table for the RAP lookup and related info for the CMR Project Request App
		
		Version: 1.1
		Last Update Date (mmddyyyy): 06-03-2025 
		Last Updated By: CM
		
		
		Version History: 
		-added refresh timestamp
		TODO: 
		-added a message info if the req description is too long (> 4000) and is truncated in the app. this message isn't actually shown and should be.
		
		*/
		//******************start of query*****************************//
		
		let
		    // Source data
		    Source = Table.SelectColumns(RAP_Projects_Staging, {
		        "RAPID",
		        "RAPTitle",
		        "RAPStatus",
		        "RAPProjectDescription",
		        "RAPProjectReason",
		        "RAPProjectConsequence",
		        "RAPProjectComments",
		        "RAPTitleLengthCheck",
		        "RAPDescCheck",
		        "RAPConseqCheck",
		        "RAPReasonCheck",
		        "RAPDataValidation"
		
		    }),
		    
		    // Filter data early if possible (adjust the filter criteria to match your needs)
		    //FilteredSource = Table.SelectRows(Source, each [SomeColumn] <> null),  // Add filter logic to reduce rows
		    
		    // Join with ProjectScoreBreakdown table
		    #"Join to ProjectScoreBreakdown" = Table.NestedJoin(Source, {"RAPID"}, ProjectScoreBreakdown, {"RAPID"}, "ProjectScoreBreakdown", JoinKind.LeftOuter),
		    
		    // Expand only the necessary columns from ProjectScoreBreakdown to avoid excess data
		    #"Get ProjectScoreBreakdown" = Table.ExpandTableColumn(#"Join to ProjectScoreBreakdown", "ProjectScoreBreakdown", {"ProjectPriorityScore", "HighScoreReq", "PlanForAsset", "BuildingPriorityDetail", "PFAScore", "IoAF", "IoAFScore", "AssetUse", "Uniformat", "IoSF", "IoSFScore", "ConditionofSystem", "ConditionScore", "Priority", "ReasonforWork", "ReasonScore", "Category", "ImpactofFailure", "ImpactScore", "Impact"}, {"ProjectPriorityScore", "HighScoreReq", "PlanForAsset", "BuildingPriorityDetail", "PFAScore", "IoAF", "IoAFScore", "AssetUse", "Uniformat", "IoSF", "IoSFScore", "ConditionofSystem", "ConditionScore", "Priority", "ReasonforWork", "ReasonScore", "Category", "ImpactofFailure", "ImpactScore", "Impact"}),
		
		/* The join to the project score breakdown is Left Outer, if there are no matching rows in that table for VFA source data, the scoring columns are null. Change the Project Priority Score and Highest Scoring Requirement to show a text message in that case. See the RAP_NoVFAData query for the ones that are not (yet) in VFA_EMPMI */
		    VFADataWaiting = Table.TransformColumns(#"Get ProjectScoreBreakdown", {
		        {"ProjectPriorityScore", each if _ = null then fnGetParameters("msg_infoRAPNoLinkedReq") else _, type text},
		        {"HighScoreReq", each if _ = null then fnGetParameters("msg_infoRAPNoLinkedReq") else _, type text}
		    }),
		/* join to vfa project staging to get the error category and counts for display and reporting */
		    #"Join to VFAProjectStaging" = Table.NestedJoin(VFADataWaiting, {"RAPID"}, VFA_Project_Staging, {"RAPID"}, "VFAProjectStaging", JoinKind.LeftOuter),
		    #"Expanded VFAProjectStaging" = Table.ExpandTableColumn(#"Join to VFAProjectStaging", "VFAProjectStaging", {"VFA Scoring Error(s)", "VFA Scoping Error(s)", "VFA Maintenance Planning Error(s)", "VFA Costing Error(s)", "Portfolio Name(s)", "Asset ID(s)", "Asset Name(s)", "Asset Use(s)", "Building Priority Detail(s)", "REQ ID(s)", "Requirement Name(s)", "Linked System(s)", "System Name(s)", "System Groups(s)", "Requirement Description(s)", "Location(s)", "Project Includes Renewal Requirements", "Asset Out For Audit", "Planned Status"}, {"VFA Scoring Error(s)", "VFA Scoping Error(s)", "VFA Maintenance Planning Error(s)", "VFA Costing Error(s)", "Portfolio Name(s)", "Asset ID(s)", "Asset Name(s)", "Asset Use(s)", "Building Priority Detail(s)", "REQ ID(s)", "Requirement Name(s)", "Linked System(s)", "System Name(s)", "System Groups(s)", "Requirement Description(s)", "Location(s)", "Project Includes Renewal Requirements", "Asset Out For Audit", "Planned Status"}),
		
		    #"Join to CostFactorModel" = Table.NestedJoin(#"Expanded VFAProjectStaging", {"RAPID"}, CostFactorModel, {"RAPID"}, "CostFactorModel", JoinKind.LeftOuter),
		    #"Get EstTPC and CostFactoredTPC" = Table.ExpandTableColumn(#"Join to CostFactorModel", "CostFactorModel", {"EstimatedTPC", "CostFactoredTPC"}, {"EstimatedTPC", "CostFactoredTPC"}),
		/*     CostWarning = Table.AddColumn(#"Get EstTPC and CostFactoredTPC", "CostWarning", each if ([CostFactoredTPC] = null) then fnGetParameters("msg_infoProjSummaryCost")[MsgTxt] else if ([CostFactoredTPC] <> null) and ([CostFactoredTPC] > fnGetParameters("msg_warnProjSummaryCostVal")) then fnGetParameters("msg_warnProjsummaryCost")[MsgTxt] else fnGetParameters("msg_infoProjSummaryCost")[MsgTxt]), */
		CostWarning = Table.AddColumn(
		    #"Get EstTPC and CostFactoredTPC", 
		    "CostWarning", 
		    each 
		        let
		            cost = [CostFactoredTPC],
		            warnThreshold = fnGetParameters("msg_warnProjSummaryCostVal"),
		            infoMsg = fnGetParameters("msg_infoProjSummaryCost")[MsgTxt],
		            warnMsg = fnGetParameters("msg_warnProjSummaryCost")[MsgTxt]
		        in
		            if cost = null then 
		                infoMsg
		            else if cost > warnThreshold then 
		                warnMsg
		            else 
		                infoMsg
		),
		
		    TruncateReqDesc = Table.TransformColumns(CostWarning, {{"Requirement Description(s)", each Text.Start(_, 4000), type text}})
		in
		    TruncateReqDesc
		```
	lineageTag: 1013b996-6489-44b1-a470-24bf79da7dfc

