/// function to lookup variables from the configuration table and use in power query
expression fnGetParameters = ```
		/*
		Function Name: fnGetParameters
		Source: Parameters (table)
		Dependencies: Working (query)
		About: This function takes the user input on the Score Tool worksheet and returns the requirements by RAP ID, Requirement ID or B/SID. Also includes a swich for also returning RAP project status APP => default is blank, DFT, REC status. 
		
		https://abgov.sharepoint.com/sites/S300D13-PMB-CORP-PROJ13424/ToolDevelopment/Funding%20Request%20Form/CMR%202.0/App/DataFlowSources/Dataflow/CMRProjectRequestExternalData_05272025.xlsx?web=1
		
		Version: 2.0
		Last Update Date (mmddyyyy): 04-0-10-2025
		Last Updated By: CM
		Release Date: 
		
		Version History: 
		- updated meta version and release date
		TODO: 
		- adjust the functionality according to the data source selection (vfa extract vs vfalinkedrequirements report)
		
		*/
		//******************start of query*****************************//
		
		let
		    Source = (ConfigName as text) as any =>
		let
		    //ConfigSource = Excel.CurrentWorkbook(){[Name = "ConfigurationTable"]}[Content],
		    ConfigSourceFile = Excel.Workbook(Web.Contents("https://abgov.sharepoint.com/sites/S300D13-PMB-CORP-PROJ13424/ToolDevelopment/Funding%20Request%20Form/CMR%202.0/App/DataFlowSources/Dataflow/CMRProjectRequestExternalData_05272025.xlsx"), null, true),
		    ConfigSource = ConfigSourceFile{[Item="ConfigurationTable",Kind="Table"]}[Data],
		    AddLowerCase = Table.AddColumn(ConfigSource, "ConfigNameLower", each Text.Lower([ConfigurationName]), type text),
		    ConfigRow = Table.SelectRows(AddLowerCase, each [ConfigNameLower] = Text.Lower(ConfigName)),
		    HasRow = not Table.IsEmpty(ConfigRow),
		    MsgTxt = if HasRow then ConfigRow{0}[Value] else null,
		    MsgLevel = if HasRow and Record.HasFields(ConfigRow{0}, "MessageLevel") then ConfigRow{0}[MessageLevel] else null,
		    Output = if MsgLevel = null or MsgLevel = 0 then MsgTxt else [MsgTxt = MsgTxt, MessageLevel = MsgLevel]
		in
		    Output
		in
		    Source
		
		
		/* (ConfigName as text) as any =>
		let
		    ConfigSource = Excel.CurrentWorkbook(){[Name = "ConfigurationTable"]}[Content],
		    AddLowerCase = Table.AddColumn(ConfigSource, "ConfigNameLower", each Text.Lower([ConfigurationName]), type text),
		    ConfigRow = Table.SelectRows(AddLowerCase, each [ConfigNameLower] = Text.Lower(ConfigName)),
		    HasRow = not Table.IsEmpty(ConfigRow),
		    MsgTxt = if HasRow then ConfigRow{0}[Value] else null,
		    MessageLevel = if HasRow and Record.HasFields(ConfigRow{0}, "MsgTxt") then ConfigRow{0}[MsgTxt] else 0,
		    Output = 
		        if MessageLevel = null or MessageLevel = 0 then
		            MsgTxt
		        else
		            [MsgTxt = MsgTxt, MessageLevel = MessageLevel]
		in
		    Output */
		```
	lineageTag: f9eefea3-3541-463a-87f2-0af5946e7531
	queryGroup: ConfigurationParameters

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Function

/// Model for the VFA Data - this query has been modified for use in the power apps - additional join to the rap staging table to limit the rows to those filterd in the rap data
expression VFA_EMPMI_Staging = ```
		/*
		Query Name: VFA_EMPMI_Staging
		Source: VFA_EMPMI, Building_List
		Dependencies: Tool specific dependencies
		About: Joins to the building list for location and contact names. Prepares the VFA data for use in other queries. 
		
		Version: 2.2
		Last Update Date(mmddyyyy): 04-10-2025
		Last Updated By: CM
		Release Date:
		
		Version History: 
		- prepare dataset for project request app
		- Added new OutForAudit and IsRenewal columns
		- Updated to use the full uniformat text for the uniformat errors.
		
		TODO: 
		
		
		*/
		//******************start of query*****************************//
		let
		    Source = Table.Buffer(Table.SelectColumns(
		        VFA_EMPMI,
		        {
		            "Portfolio_Name", //transformation removes the Win1252 characters and rename to data model
		            //{"Property_Name", type text},
		            //{"Asset_EID", type any},
		            "Asset_Name", //rename to data model
		            "Building_ID", //renamed to Asset ID in data model
		            //renamed to Asset Use
		            "Use_Type", //rename to asset use, set to site for blank and building_id starts with S
		            //{"Constructed_Year",  Int64.Type},
		            "Building_Priority_Detail", //rename to data model
		            "Requirement_EID", //rename to data model as REQ ID
		            "Requirement_Name", //rename to data model
		            "Requirement_Description", //rename to data model
		            "Category", //rename to data model
		            "Priority", //rename to data model
		            "Impact", //rename to data model
		            "EstimatedCost", //rename to data model
		            //{"RankingOne", type text},
		            //{"RankingTwo",type text},
		            "RAPProjectID", //rename to data model
		            "RAPProjectStatus", //rename to data model used to check if status COM
		            "System_EID", //need this for error checking against the VFA SSRS
		            "System_Name", //rename to data model
		            "Uniformat", //UNIFORMAT renamed to Requirement - Linked System
		            "System_Group", //rename to data model
		            "OutForAudit",
		            "IsRenewal"
		        }
		    )),
		    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Portfolio_Name", type text}}),
		    #"Replace Win1252 Encoded Dash Portfolio" = Table.ReplaceValue(#"Changed Type","â€“","-",Replacer.ReplaceText,{"Portfolio_Name"}),
		    #"Replace Win1252 Encoded Dash Sys Name" = Table.ReplaceValue(#"Replace Win1252 Encoded Dash Portfolio","â??","-",Replacer.ReplaceText,{"System_Name"}),
		    #"Removed Blank Rows" = Table.SelectRows(#"Replace Win1252 Encoded Dash Sys Name", each not List.IsEmpty(List.RemoveMatchingItems(Record.FieldValues(_), {"", null}))),
		    //asset use is blank for sites, VFA SSRS manages trailers and parking lots already, this is different than when using a vfa data extract where three separate use columns are present. 
		    #"Set Blank Site Use" = Table.ReplaceValue(#"Removed Blank Rows", "", "Site", Replacer.ReplaceValue, {"Use_Type"}),
		    #"Rename to Data Model" = Table.RenameColumns(
		        #"Set Blank Site Use",
		        {
		            {"Portfolio_Name", "PortfolioName"},
		            {"Asset_Name", "AssetName"}, 
		            {"Building_ID", "AssetID"},
		            {"RAPProjectID", "RAPID"},
		            {"Requirement_EID", "REQID"},
		            {"RAPProjectStatus", "RAPStatus"},
		            {"Use_Type", "AssetUse"},
		            {"Building_Priority_Detail", "BuildingPriorityDetail"},
		            {"EstimatedCost", "EstimatedCost"},
		            {"Requirement_Description", "RequirementDescription"},
		            {"Requirement_Name", "RequirementName"},
		            {"System_Group", "VFASystemGroup"}, //distict the vfa system group from master system group in output of scoring model
		            {"System_Name", "SystemName"}
		        }
		    ),
		    #"Join to Building List" = Table.NestedJoin(#"Rename to Data Model", {"AssetID"}, Building_List, {"BLDGID"}, "Building_List", JoinKind.LeftOuter),
		    #"Get Location" = Table.ExpandTableColumn(
		        #"Join to Building List",
		        "Building_List",
		        {"LOCATION"},
		        {"Location"}
		    ),
		        //The Uniformat text in the SSRS doesn't have exta spaces between the uniformat code and the hyphen like the IoSF table does. (example: A1010 - Standard Foundations* on IoSF but A1010-Standard Foundations* in the report). Adds the extra spaces to the Uniformat column so the strings will match exactly. Using the full string to catch and check error condition messages for 150 year lifetimes have an * in dependent queries
		    #"Uniformat Text Match Replace" = Table.TransformColumns(
		        #"Get Location",
		        {
		            "Uniformat",
		            each
		                let
		                    pos = Text.PositionOf(_, "-")
		                    // Find first occurrence of "-"
		                in
		                    if pos <> -1 then
		                        Text.Start(_, pos) & " - " & Text.Middle(_, pos + 1)
		                    else
		                        _,
		            type text
		        }
		    ),
		    //the VFA SSRS has empty string instead of null values. Replace all blanks (empty string) to null for condition check in dependent queries
		        #"Replace Blank Report Values with Null" = Table.ReplaceValue(
		        #"Uniformat Text Match Replace",
		        "",
		        null,
		        Replacer.ReplaceValue,
		        {"RequirementName", "RequirementDescription", "Category", "Priority", "Impact", "Uniformat", "VFASystemGroup" }
		    ),
		    //make sure requirement estimated cost is not null for any of the rows
		    #"Replace Null Est Cost with 0" = Table.ReplaceValue(#"Replace Blank Report Values with Null",null,0,Replacer.ReplaceValue,{"EstimatedCost"}),
		    #"Reordered Columns" = Table.ReorderColumns(#"Replace Null Est Cost with 0",{"RAPID", "RAPStatus", "PortfolioName", "AssetName", "AssetID", "AssetUse", "BuildingPriorityDetail", "REQID", "RequirementName", "RequirementDescription", "Category", "Priority", "Impact", "EstimatedCost", "SystemName", "Uniformat", "VFASystemGroup", "System_EID", "OutForAudit", "IsRenewal"
		    , "Location"
		    }
		    ),
		    //limiting the amount of data processing for the vfa project staging - only those RAP ID's. Don't want to include all the VFA data in the output
		    #"Limit VFA To ONLY RAP Query" = Table.NestedJoin(#"Reordered Columns", {"RAPID"}, RAP_Projects_Staging, {"RAPID"}, "RAP_Projects_Staging", JoinKind.Inner),
		    #"Cleaned Text" = Table.TransformColumns(#"Limit VFA To ONLY RAP Query",{{"RequirementDescription", Text.Clean, type text}})
		in
		    #"Cleaned Text"
		```
	lineageTag: 24a47086-1b22-4e8d-9fda-e8baea79e79f
	queryGroup: StagingModels

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

/// Source RAP SSRS with Date Filter from config table (or default now - 5yrs), includes rap data validation flag and messages within the query.
expression RAP_Projects_Staging = ```
		/*
		Query Name:RAP_Project_Staging
		Source: RAP_Project_SSRS
		Dependencies: ProjectRequestSummary
		About: Provides the RAP lookups and related infomration for the CMR Project Request App
		
		Version: 1.0
		Last Update Date (mmddyyyy): 05-28-2025 
		Last Updated By: CM
		Release Date: 
		
		Version History: 
		- release version
		TODO: 
		
		
		*/
		//******************start of query*****************************//
		
		let
		    //the SSRS does not have null for blank values, blanks have a space.
		    Source = Table.Buffer(Table.SelectColumns(RAP_Projects_SSRS, 
		    //confirm data types, the number field needs to stay text. pq will try to make this a number
		        {
		            "Property",
		            "Number",
		            //"Name",
		            "Title",
		            "Status",
		            //"raApprovedTPC",
		            //"raProjMgr",
		            //"Initiator",
		            //"FUDesc",
		            "Description",
		            "Reason",
		            "Consequences",
		            "Critical",
		            "Record_Created"
		        }
		    )),
		    //combine property and number into a single RAP ID column with a hyphen delimeter
		    #"Combine for RAP ID" = Table.CombineColumns(
		        Source, {"Property", "Number"}, Combiner.CombineTextByDelimiter("-", QuoteStyle.None), "RAPID"
		    ),
		    #"Rename to dataModel" = Table.RenameColumns(
		        #"Combine for RAP ID",
		        {
		            //{"Name", "Asset Name"},
		            {"Title", "RAPTitle"},
		            {"Status", "RAPStatus"},
		            //{"raProjMgr", "RAP Project Manager"},
		            //{"FUDesc", "Funding Description"},
		            {"Description", "RAPProjectDescription"},
		            {"Reason", "RAPProjectReason"},
		            {"Consequences", "RAPProjectConsequence"},
		            {"Critical", "RAPProjectComments"}
		        }
		    ),
		    #"Trimmed Blanks" = Table.TransformColumns(
		        #"Rename to dataModel",
		        {
		            {"RAPProjectComments", Text.Trim, type text},
		            {"RAPProjectConsequence", Text.Trim, type text},
		            {"RAPProjectReason", Text.Trim, type text},
		            {"RAPProjectDescription", Text.Trim, type text}
		        }
		    ),
		    #"Replace Blanks with Null" = Table.ReplaceValue(
		        #"Trimmed Blanks",
		        "",
		        null,
		        Replacer.ReplaceValue,
		        {"RAPProjectDescription", "RAPProjectReason", "RAPProjectConsequence", "RAPProjectComments"}
		    ),
		    //filter out cancelled and the DE
		    #"Filter by RAP Status" = Table.SelectRows(
		        #"Replace Blanks with Null", each ([RAPStatus] <> "CAN" and [RAPStatus] <> "DE")
		    ),
		    #"Trim RAP ID" = Table.TransformColumns(#"Filter by RAP Status", {{"RAPID", Text.Trim, type text}}),
		         // YYYY-MM-DD hh,mm,ss
		    // Retrieve the configuration date value
		    RAPFilterConfigDateRow = Table.SelectRows(ConfigurationTable, each [ConfigurationName] = "RAPFilterDate"),
		    RAPFilterConfigDate = if Table.RowCount(RAPFilterConfigDateRow) > 0 then RAPFilterConfigDateRow{0}[Value] else DateTime.LocalNow(),  // Fallback to current date if no match
		    
		    // Default to 5 years ago if no match was found
		    RAPFilterConfigDateDefault = Date.AddYears(DateTime.LocalNow(), -5),
		    
		    // Ensure that RAPFilterConfigDate is of type datetime (if it's a text or date, convert it)
		    RAPFilterConfigDateConverted = if Value.Is(RAPFilterConfigDate, type datetime) then RAPFilterConfigDate else RAPFilterConfigDateDefault,
		    
		    // Filter rows by the date from the configuration table
		    #"Filter by Create_Date" = Table.SelectRows(#"Trim RAP ID", each [Record_Created] > RAPFilterConfigDateConverted),
		
		    #"Sort by Create Date" = Table.Sort(#"Filter by Create_Date", {{"Record_Created", Order.Descending}}),
		    #"Check RAP Title Length" = Table.AddColumn(
		        #"Sort by Create Date",
		        "RAPTitleLengthCheck",
		        each
		            if Text.Length([#"RAPTitle"]) > 40 then
		                fnGetParameters("msg_warnRAPTitleLength")[MsgTxt]
		            else
		                "--"
		    ),
		    #"Check RAP Description" = Table.AddColumn(
		        #"Check RAP Title Length",
		        "RAPDescCheck",
		        each if ([RAPProjectDescription] = null) or ([RAPProjectDescription] = "") then fnGetParameters("msg_errorRAPDesc")[MsgTxt] 
		        else fnGetParameters("msg_passRAPDescValidation")[MsgTxt]
		    ),
		    #"Get RAP Description Error Level" = Table.AddColumn(
		        #"Check RAP Description",
		        "RAPDescLevel",
		        each if ([RAPDescCheck] <> "--") 
		            then fnGetParameters("msg_errorRAPDesc")[MessageLevel] 
		            else null
		    ),
		
		    #"Check RAP Consequence" = Table.AddColumn(
		        #"Get RAP Description Error Level",
		        "RAPConseqCheck",
		        each if ([RAPProjectConsequence] = null) or ([RAPProjectConsequence] = "") then fnGetParameters("msg_errorRAPConsequence")[MsgTxt] 
		        else fnGetParameters("msg_passRAPConsValidation")[MsgTxt]
		    ),
		    #"Get RAP Consequence Error Level" = Table.AddColumn(
		    #"Check RAP Consequence",
		    "RAPConseqLevel",
		    each if ([RAPConseqCheck] <> "--") 
		        then fnGetParameters("msg_errorRAPDesc")[MessageLevel] 
		        else null
		),
		    #"Check RAP Reason" = Table.AddColumn(
		        #"Get RAP Consequence Error Level",
		        "RAPReasonCheck",
		        each if ([RAPProjectReason] = null) or ([RAPProjectReason] = "") then fnGetParameters("msg_errorRAPReason")[MsgTxt]  
		        else fnGetParameters("msg_passRAPReasonValidation")[MsgTxt] 
		    ),
		    #"Get RAP Reason Error Level" = Table.AddColumn(
		    #"Check RAP Reason",
		    "RAPReasonLevel",
		    each if ([RAPReasonCheck] <> "--") 
		        then fnGetParameters("msg_errorRAPDesc")[MessageLevel] 
		        else null
		),
		/*     #"Data Validation Flag" = Table.AddColumn(#"Get RAP Reason Error Level", "RAPDataValidation", 
		    each 
		    let
		        columns = {
		            [RAPDescLevel],
		            [RAPConseqLevel],
		            [RAPReasonLevel]
		        },
		        errorCount = List.Count(List.Select(columns, each _ = 1)),  
		        //warningCount = List.Count(List.Select(columns, each _ = 2)),  
		        //totalColumns = List.Count(columns),
		        //totalIssues = errorCount + warningCount,
		        validationText = 
		            if errorCount > 0 then
		                fnGetParameters("msg_errorRAPDataValidation")[MsgTxt]
		            else
		                fnGetParameters("msg_passRAPDataValidation")
		        //totalIssuesText = Text.From(totalIssues)
		    in
		        validationText */
		        #"check function" = fnGetParameters("msg_errorRAPDataValidation"),
		#"Data Validation Flag" = Table.AddColumn(#"Get RAP Reason Error Level", "RAPDataValidation",  
		    each 
		    let
		        columns = {
		            Record.FieldOrDefault(_, "RAPDescLevel", null),
		            Record.FieldOrDefault(_, "RAPConseqLevel", null),
		            Record.FieldOrDefault(_, "RAPReasonLevel", null)
		        },
		        errorCount = List.Count(
		            List.Select(columns, each _ = 1)
		        ),
		        validationText = 
		            if errorCount > 0 then
		               Text.From(errorCount) //fnGetParameters("msg_errorRAPDataValidation")[MsgTxt] & " " & Text.From(errorCount)
		            else
		                0
		    in
		        validationText
		)
		in
		    #"Data Validation Flag"
		```
	lineageTag: ee273236-c019-45c0-87b6-163333d22968
	queryGroup: StagingModels

