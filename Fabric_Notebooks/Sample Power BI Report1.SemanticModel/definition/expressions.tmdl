		These connections used to be managed by a sheet in the workbook, this was changed to ensure consistent application of the scoring tables from a single source for all tools. 
		
		TODO: 
		- 
		
		*/
		//******************start of query*****************************//
		let
		    //connect to the master file
		    Source = #"MasterScoringConnection",
		    // connect to the master file
		    ImpactOfFailure_Table = Source{[Item = "ImpactOfFailure", Kind = "Table"]}[Data],
		    #"Changed Type" = Table.TransformColumnTypes(
		        ImpactOfFailure_Table,
		        {
		            {"Requirement Impact", type text},
		            {"Impact of Failure", type text},
		            {"Score", Int64.Type},
		            {"Score with Weight", Int64.Type},
		            {"Weight", Int64.Type}
		        }
		    )
		in
		    #"Changed Type"
		```
